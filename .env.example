# Disposable local test configuration only. Automatic pytest runs generate their own.
# Never use production credentials. Do not commit a real .env file.
# Copy into local .env; fill token privately (never paste it into AI chat).
# The endpoint is third-party; verify its API compatibility and pricing before live calls.
CC_VIBE_ANTHROPIC_BASE_URL=https://cc-vibe.com
CC_VIBE_ANTHROPIC_AUTH_TOKEN=
CC_VIBE_ANTHROPIC_MODEL=claude-fable-5-1
CC_VIBE_ANTHROPIC_EFFORTLEVEL=max
ANOVELOS_TEST_DB=bootstrap_test
ANOVELOS_TEST_USER=bootstrap_test
ANOVELOS_TEST_PASSWORD=LOCAL_TEST_ONLY_CHANGE_ME
# ANOVELOS_TEST_DSN=postgresql+psycopg://bootstrap_test:LOCAL_TEST_ONLY_CHANGE_ME@127.0.0.1:<dynamic-port>/bootstrap_test
